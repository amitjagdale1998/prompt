# Example environment variables for the Prompt Lab backend.
# Copy to `.env` and replace placeholder values before running the server.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/promptlab

# Must be at least 16 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Must be at least 8 characters. Required to register admin accounts.
ADMIN_REGISTRATION_CODE=replace-me-admin-code

CORS_ORIGIN=http://localhost:4173
UPLOAD_DIR=uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
